# Copy this file to .env and update values as needed

# Flask settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database (SQLite - file will be created in backend folder)
DATABASE_URL=sqlite:///placement_portal.db

# JWT settings (for later use)
JWT_SECRET_KEY=change-this-to-a-random-jwt-secret

# Redis — Flask-Caching (Stage 9.1) and Celery broker/backend (Stage 9.2 / 9.3)
# Start Redis locally before running the backend / Celery worker (default port 6379)
REDIS_URL=redis://localhost:6379/0

# Stage 9.3: Celery Beat schedule
# false = every day at 9:00 AM Asia/Kolkata
# true  = every 1 minute (local testing)
CELERY_BEAT_TEST_MODE=false

# Stage 9.3: reminder windows (used by scheduled daily job; defaults are production-safe)
# Drive deadline must fall within REMINDER_DAYS from now
REMINDER_DAYS=2
# Interview datetime must fall within INTERVIEW_REMINDER_DAYS from now (1 ≈ former 24h rule)
INTERVIEW_REMINDER_DAYS=1

# Stage 9.3: Email via MailHog (local SMTP — no real email account required)
# Start MailHog first, then open http://localhost:8025 to view captured emails
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=False
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=placement-portal@localhost
# Keep false so emails are delivered to MailHog
MAIL_SUPPRESS_SEND=false
